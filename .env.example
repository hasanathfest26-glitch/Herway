# PostgreSQL + PostGIS (Supabase or Docker)
DATABASE_URL="postgresql://herway:herway_secret@localhost:5432/herway?schema=public"

# Supabase Auth & Private Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_STORAGE_BUCKET_DOCUMENTS="travel-documents-private"
SUPABASE_STORAGE_BUCKET_VERIFICATION="verification-private"

# Application Security & Vault Encryption (32-byte hex key)
JWT_SECRET="change-me-in-production-min-32-chars"
DOCUMENT_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis & BullMQ
REDIS_HOST="localhost"
REDIS_PORT=6379

# Google Maps Platform
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""

# URLs
BACKEND_PORT=3001
PUBLIC_TRACKING_BASE_URL="http://localhost:3000/track"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
EXPO_PUBLIC_API_URL="http://localhost:3001/api/v1"
EXPO_PUBLIC_WS_URL="http://localhost:3001"
